# Sources and text are LF in the repository (a Windows editor or script that
# writes CRLF is normalised on commit). The permuter's results are kept as written.
*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.s      text eol=lf
*.inc    text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.lcf    text eol=lf
*.csv    text eol=lf
*.json   text eol=lf
Makefile text eol=lf
permuter/results/** -text
